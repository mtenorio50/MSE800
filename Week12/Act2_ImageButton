import os
from flask import Flask, request, render_template, send_from_directory

app = Flask(__name__)
IMAGES = 'Week12/uploads'
app.config['IMAGES'] = IMAGES

# Make sure the folder IMAGES exists
os.makedirs(IMAGES, exist_ok=True)

@app.route("/hello/<name>")
def hello_flask(name):
    return f"Hello, {name}"

@app.route("/upload", methods=["GET", "POST"])
def upload_file():
    filename = None
    if request.method == "POST":
        file = request.files['file']
        if file and file.filename != '':
            filepath = os.path.join(app.config['IMAGES'], file.filename)
            print("Saving to:", filepath)
            file.save(filepath)
            print("Saved:", os.path.exists(filepath))
            filename = file.filename
    return render_template("upload.html", filename=filename)

@app.route('/uploads/<filename>')
def uploaded_file(filename):
    print("Serving:", filename, "from", app.config['IMAGES'])
    return send_from_directory(app.config['IMAGES'], filename)

if __name__ == "__main__":
    app.run(debug=True)
